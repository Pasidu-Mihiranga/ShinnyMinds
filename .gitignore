# Unity generated files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# Asset meta data should be tracked
!/[Aa]ssets/**/*.meta

# Autogenerated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Visual Studio / Rider
.vscode/
.vs/
*.csproj.user
*.sln.docstates
*.idea/
*.idea/*

# Temporary files
*.tmp
*.temp
*.log
*.log.*

# Unity specific caches
MemoryCaptures/
AssetCache.db
ScriptAssemblies/

# Crash dumps
*.dmp
*.stackdump

# Backup files
*.bak
*.orig
*.old
*.sav

# Secrets - never commit real keys (see .env.example)
.env
.env.*
!.env.example

# Node / web tooling
node_modules/
dist/
.vite/
npm-debug.log*

# Prisma local state
backend/prisma/*.db

# Player builds and the API keys baked into them
/Builds/
/Assets/Resources/BuildConfig.txt
/Assets/Resources/BuildConfig.txt.meta
