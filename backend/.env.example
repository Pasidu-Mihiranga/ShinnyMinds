# ShinyMinds backend configuration
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://shinyminds:shinyminds@localhost:5432/shinyminds?schema=public"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
# Add the Vite dev server and, later, the deployed dashboard URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minutes east of UTC. Decides when a "day" starts for playtime and for the daily
# skill snapshots behind the trend chart. Leaving this at 0 (UTC) means a family at
# UTC+5:30 has their day roll over at 5:30am local, so early-morning play is counted
# against the previous day.
#   330 = Sri Lanka / India (UTC+5:30)     0 = UTC
# Set it once, before there is data: changing it later shifts which day existing
# snapshots appear to belong to.
APP_TIMEZONE_OFFSET_MINUTES=330

# --- Auth -------------------------------------------------------------------
# Long random strings. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Groq (parent assistant chatbot) ----------------------------------------
# The dashboard never sees this key. The browser calls this API, and this API
# calls Groq, so the key stays on the server.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
