# Parent dashboard configuration
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the browser. Never put a
# secret here - anything in this file ships to every visitor in the JS bundle.
# The Groq key lives in backend/.env and is used server-side only.

# Base URL of the ShinyMinds API (see backend/README.md). No trailing slash.
VITE_API_URL=http://localhost:4000
