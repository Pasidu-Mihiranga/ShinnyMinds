# ShinyMinds - Unity client configuration
#
# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is git-ignored: never commit it, and never paste keys into the Unity Inspector.
#
#   cp .env.example .env
#
# The Editor reads this file at play time. Values already exported as real
# environment variables take priority over anything written here.

# Groq - powers NPC dialogue generation (Assets/GroqDialogue.cs)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs - powers NPC and child text-to-speech (Assets/ElevenLabsTTS.cs)
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenLabs voice IDs. Find them under Voices in the ElevenLabs dashboard.
# A voice ID set on an individual ElevenLabsTTS component overrides these defaults.
ELEVENLABS_NPC_VOICE_ID=
ELEVENLABS_GIRL_VOICE_ID=

# ShinyMinds backend (see backend/README.md). No trailing slash.
SHINYMINDS_API_URL=http://localhost:4000
